# Supabase — Settings → API en tu proyecto de supabase.com
NEXT_PUBLIC_SUPABASE_URL=https://tu-proyecto.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=tu_anon_key
# Solo para el webhook de Apify (server-only, NUNCA con prefijo NEXT_PUBLIC_)
SUPABASE_SERVICE_ROLE_KEY=tu_service_role_key

# Gemini Vision — aistudio.google.com → Get API Key
GEMINI_API_KEY=tu_clave_de_gemini

# Apify — apify.com → Settings → Integrations (token) y el secreto que
# configures tú mismo en el webhook de tu tarea de Apify
APIFY_TOKEN=tu_apify_api_token
APIFY_WEBHOOK_SECRET=un_texto_secreto_cualquiera
